; Blocksmith — the world vertex shader, adaptive-lighting variant (v1.5.0).
;
; Compiled alongside world.v.pica. STALE AS OF v1.8.0 (corrected here, not restated at the
; other copy): this header used to say "bound INSTEAD of it on a New 3DS only", which was true
; through v1.7.0. Since the v1.8.0 shader split, THIS program is bound on BOTH console models
; and world.v.pica is compiled and never bound — see world.v.pica's own tintPalette comment and
; scene/chunk_render.c's chunkRenderInit, which parses world_dynamic_shbin.h unconditionally.
;
; The one difference from world.v.pica is what the mesher puts in MeshVertex.pad.
; There it is alignment filler the shader overwrites; here it carries the corner's
; smooth light packed by world/mesher.c as sky<<4 | block, both 0..15, averaged
; over the four cells touching the corner (the same taps the AO rule walks).
;
;   lum        = min(1, curve(sky x dayLevel) + 1.5 x curve(block))   -- v1.8.10
;   brightness = faceShade[nrm] x aoCurve(ao) x lum
;
;   curve(l) = l / (4 - 3l)     -- v1.8.9, see curveConsts below for the citation
;
; v1.8.10 replaced a max() of the two channels with the sum vanilla actually uses. See the long
; note at the combine itself; the short version is that under max() an emitter could never
; brighten a spot past whatever the sky was already giving it, so a torch in daylight did
; nothing at all.
;
; With dayLevel 1.0 and full sky light the sky term alone is curve(1) = 1 and the clamp holds
; it there, so a fully sunlit face still matches the baked shader's output exactly; underground
; the sky term falls to nothing and only the emitters light the place, without any remeshing.
; dayLevel is a uniform so the day/night cycle is one register write per frame, not a re-mesh.
;
; Attributes (see MeshVertex in source/world/mesh_vertex.h — the format is locked):
;   v0 = position, 4x u8 — xyz read, w is the pad byte this shader exists to read
;   v1 = (u, v, normal index, ao), 4x u8
;
; v0 is fetched UNSIGNED even though MeshVertex declares x, y, z as int8_t: positions are
; chunk-local 0..16 so the wider type costs nothing, and pad reaches 255, which a signed
; fetch would hand this shader as -16 — every sunlit surface unlit. The header said "4x s8"
; until v1.8.10; scene/chunk_render.c:958 has always been GPU_UNSIGNED_BYTE since v1.8.0.
; It matters because the whole light unpack below assumes a non-negative w, and so does the
; rcp: curve(l) = l / (4 - 3l) only stays away from a zero denominator while l is in 0..1.

.fvec projection[4], modelView[4]

; Per-vertex face table, indexed by the WHOLE nrm byte: .x is the face's baked
; brightness, .y a height offset added to the vertex's y. 64 rows, filled by
; scene/chunk_render.c, row face + 8*d holding brightness(face) and -d/8. Same layout
; and same reasoning as world.v.pica — see the long note there and MESH_NRM_FACE_BITS in
; source/world/mesher.h. It must move with it — and since v1.8.0 that is true on BOTH console
; models, not just a New 3DS: this is the only world program that is ever bound, so a drift
; here leaves flowing water full-height everywhere, not on one machine. (This paragraph said
; "a New 3DS binds THIS program instead" until v1.8.10, contradicting the header six lines up.)
.fvec faceShade[64]

; Day-night multiplier for the sky channel. Held per-channel-scaled so caves lit
; only by block light do not dim with the sun.
.fvec dayLevel[1]

; v1.9.0 distance fog. .x is texcoord per block, .y is the coordinate at zero distance, so
; the fog coordinate is u = depth * .x + .y — an affine map of LINEAR eye-space depth onto
; the 128-texel ramp on texture unit 1. .z and .w are unused. Filled by
; scene/chunk_render.c's pipelineBind from fogShapeFor() (source/gfx/fogramp.c), which is
; also where the whole design and its measurement live.
;
; This replaced the PICA200's fixed-function fog unit, which is a 128-entry LUT indexed by
; 1/w: the knots bunch against the camera, the first one past the far plane sits at 20.6767
; blocks with the near plane at its cap, and everything beyond it is one straight line — so
; the fade could not be shaped past ~20.7 blocks at ANY render distance, and half_vis
; saturated at 14.34 / 14.37 / 14.41 blocks for radius 3 / 4 / 5. Eye-space depth has no
; knots in it.
;
; Must match world.v.pica exactly; source/world/atlas_uv_shader_test.c parses the fog
; declarations and the fog instruction block out of BOTH files, same as it already does for
; uvScale and as water_alpha_test.c does for the alpha line.
.fvec fogParams[1]

; v1.8.8 biome tint. Eight RGB multipliers, indexed by bits 2..4 of the vertex's ao byte
; (MESH_TINT_BITS in source/world/mesher.h). Row 0 is (1,1,1) — the identity — and is what
; every untintable face and every vertex meshed without a biome source carries, so this
; multiply is exactly 1.0 for all of them and the frame is unchanged.
;
; EIGHT ROWS IS THE CAP, and it is this bank that sets it, not the vertex byte. The PICA200
; vertex stage has 96 float uniform registers in total; this program already spent 78, so a
; palette of 8 takes it to 86 and a palette of 16 would not fit beside faceShade's 64. Three
; bits is therefore what the mesher packs, and BIOME_COUNT (world/worldgen.h) is 6.
;
; Filled by scene/chunk_render.c's pipelineBind from meshTintRow(), and re-uploaded on every
; bind for the same reason faceShade is: the uniform bank is shared hardware and the highlight
; program's own uniforms land in the same registers.
;
; Must match world.v.pica exactly; source/world/biome_tint_test.c parses the declaration and
; the decode instructions out of BOTH files, same as water_alpha_test.c does for the alpha and
; atlas_uv_shader_test.c does for uvScale.
.fvec tintPalette[8]

; v1.8.10 water shimmer. .x and .y are the scrolling UV offset, .z is texture repeats per block,
; .w unused. Filled by scene/chunk_render.c's pipelineBind from gfx/watershimmer.h, which is
; also where the arithmetic and its reasoning live and is what world/water_alpha_test.c links.
;
; It is uploaded on EVERY bind, including when the shaders option is off — and that is the one
; deliberate exception to this feature's "no new GPU state by default" rule, so it is written
; down here rather than left to be rediscovered. The instructions below are unconditional: the
; PICA200 has no branch worth spending here and a vertex shader cannot be part-compiled, so
; outtc2 is always written and the uniform is always read. Leaving it unwritten would mean the
; shader reading whatever the previous program left in that register bank, which on this
; hardware is shared with the highlight program's uniforms. With the option off the offsets are
; uploaded as zeros; nothing samples texcoord2, because no texture is bound to unit 2 and no
; TEV stage sources it, so the varying is computed and discarded.
;
; This is the 87th of the vertex stage's 96 float uniform registers — see the tintPalette note
; above for the count and for why 8 palette rows was the cap.
;
; NOT in world.v.pica. That program is compiled and never bound (see this file's header), and
; the v1.8.10 scope owns this file only. Nothing parses this declaration out of both.
.fvec waterShimmer[1]

; v1.8.8. Splitting the ao byte: 1/4 shifts the tint index down out of bits 2..4, -4 undoes
; that shift inside the byte so what is left is the ambient occlusion 0..3. Exactly the shape
; of the light unpack below, which splits inpos.w the same way with 1/16 and -16.
.constf tintConsts(0.25, -4.0, 0.0, 0.0)
.alias  inv4 tintConsts.xxxx
.alias  neg4 tintConsts.yyyy

; Same layout constant as world.v.pica, and it must move with it — see the long note there.
; The atlas is a one-tile-wide strip, so x = 1/ATLAS_W_PX; and since task 13b the vertex's v
; byte is a slot-edge index rather than a pixel row, so y = TILE_PX/ATLAS_H_PX, not
; 1/ATLAS_H_PX. Both from source/world/atlas_uv.h.
; source/world/atlas_uv_shader_test.c parses this line out of THIS file too, not just
; world.v.pica: a New 3DS binds this program instead, so a drift here would go unseen on
; every Old 3DS the suite happens to be checked against.
.constf uvScale(0.0625, 0.015625, 0.0, 0.0)       ; 1/ATLAS_W_PX = 1/16, TILE_PX/ATLAS_H_PX = 16/1024

.constf consts(0.0, 1.0, 0.0, 0.33333333)         ; 0, 1, spare (was uvScale), 1/3
.alias  zeros consts.xxxx
.alias  ones  consts.yyyy
.alias  aoScale consts.wwww

.constf aoMix(0.45, 0.55, 0.0, 0.0)
.alias  aoFloor aoMix.xxxx
.alias  aoRange aoMix.yyyy

; Light unpack constants: 1/16 turns the pad byte into the sky nibble, -16 undoes
; sky*16 inside the byte, 1/15 normalises a nibble to 0..1.
.constf lightConsts(0.0625, -16.0, 0.06666667, 0.0)
.alias  inv16   lightConsts.xxxx
.alias  neg16   lightConsts.yyyy
.alias  inv15   lightConsts.zzzz

; v1.8.9. The vanilla light-to-brightness curve, b = l / (4 - 3l), read off the decompiled
; client (MCP-919 EntityRenderer.updateLightmap, cited in full in
; docs/research/sky-and-weather.md E3) and restated in docs/VERSION-LIST.md's v1.8.9 entry:
; "A linear light-to-brightness ramp would render full night 3.2x too bright."
;
; v1.8.10 correction. This note used to argue that one curve over the combined max() was the
; same shape as vanilla's two, and that argument only held because the combine was a max().
; It is a sum now, and curve(a + b) is NOT curve(a) + curve(b) for a concave curve, so the
; shader applies the curve to each channel separately exactly as vanilla does. l below is
; therefore the raw sky or block nibble, never the combined value.
;
; Concretely: dayLevel's own floor already holds a fully sky-lit face at l=4/15=0.2667 at
; midnight (world/daynight.h). Uncurved, that renders at 26.67% brightness — visibly not
; night. Curved: 0.2667/(4-0.8) = 0.2667/3.2 = 0.0833, an eighth of full brightness, which is
; the "3.2x too bright" VERSION-LIST.md names (0.2667/0.0833 = 3.2 exactly).
.constf curveConsts(4.0, -3.0, 1.5, 0.0)
.alias  curveFour     curveConsts.xxxx
.alias  curveNegThree curveConsts.yyyy

; v1.8.10. Vanilla multiplies the CURVED block term by (torchFlickerX * 0.1F + 1.5F) before
; adding it to the sky term. torchFlickerX is a small wander around zero, so with flicker at
; rest the multiplier is exactly 1.5, and that is what this constant is. It is what makes a
; torch read as a torch rather than as a slightly-less-dark patch: without it a block light of
; 14 would peak at curve(14/15) = 0.918, below a fully sky-lit face, and a lit room would look
; dimmer than daylight outdoors instead of blowing out to white the way it should.
.alias  curveBlockMul curveConsts.zzzz

.out outpos position
.out outtc0 texcoord0
.out outclr color

; v1.9.0. The fog coordinate, on its own varying.
;
; It could NOT ride on the spare lanes of outtc0. `mov outtc0, r2.xyxy` does write z and w,
; but texcoord0 is a TWO-component output semantic on this hardware — the assembler maps .x
; and .y and the rasterizer never sees the other two, so those lanes are discarded rather
; than spare. The only other route into texcoord0 is the separate `texcoord0w` semantic,
; which feeds texture unit 0's third coordinate and cannot be sampled by unit 1 at all.
; texcoord1 is unwritten everywhere else in the tree, so this costs nothing that was in use.
.out outtc1 texcoord1

; v1.8.10. The water shimmer coordinate, on the third and last texcoord varying.
;
; It could not share outtc1 for the same reason the fog coordinate could not share outtc0:
; texcoord1 is a two-component semantic and the fog already uses both (the shader writes the
; same value into .x and .y, but the rasterizer only ever carries two lanes). It has to be its
; own semantic, and texcoord2 is the one texture unit 2 reads.
;
; WHICH TEXCOORD UNIT 2 SAMPLES WITH is the one thing the plan (docs/plan-1.8.10-light.md 7)
; left unresolved, so the evidence is recorded here. GPUREG_TEXUNIT_CONFIG bit 13 selects it:
; set, unit 2 reads texcoord1; clear, it reads texcoord2. Azahar names that bit
; `texture2_use_coord1` in src/video_core/pica/regs_texturing.h, and citro3d's C3D_Init
; (source/base.c) initialises ctx->texConfig to BIT(12) alone and writes the register with a
; mask that covers bit 13 — so bit 13 is written ZERO and nothing in this tree ever sets it.
; Unit 2 therefore samples texcoord2. If that is ever wrong the symptom is specific and worth
; knowing: the shimmer would be sampled with the FOG coordinate, i.e. a function of camera
; distance, so the glints would sit still relative to the screen and sweep when the player
; walks toward the water rather than drifting on it.
;
; This output is written unconditionally — see the waterShimmer uniform's note above.
.out outtc2 texcoord2

.alias inpos v0
.alias inpack v1

.proc main
	; --- the vertex's face table row --------------------------------------
	; Fetched first because the position below needs its .y. Same two instructions and same
	; relative-addressed fetch as world.v.pica, moved above the position block for the same
	; reason. v1.2.4's measurement cleared them of the hardware freeze; see world.v.pica.
	mova a0.x, inpack.zzzz
	mov r3, faceShade[a0.x]

	; --- v1.8.8 biome tint: split the ao byte and fetch the palette row ----
	; inpack.w is ao | tint<<2 (world/mesher.h). The whole byte used to BE the occlusion and
	; the ao curve below multiplied it by 1/3 with no mask, so leaving the tint in it would
	; not be ignored — it would read as an occlusion of up to 31 and blow the face to white.
	; That is why this split is not optional and why it happens before anything reads .w.
	;
	; a0.x is re-loaded here rather than kept: r3 is already fetched above, so the faceShade
	; row this would clobber has been read and the register is free.
	mul r8.x, inv4, inpack.wwww          ; ao byte / 4
	flr r8.x, r8.xxxx                    ; tint index 0..7
	mul r9.x, neg4, r8.xxxx              ; -4 * tint
	add r9.x, r9.xxxx, inpack.wwww       ; ao 0..3, the value this shader always read
	mova a0.x, r8.xxxx
	mov r10, tintPalette[a0.x]

	; --- position ---------------------------------------------------------
	mov r0.xyz, inpos

	; v1.8.0 task 22b: the water height drop, 0.0 for every face index 0..5.
	add r0.y,   r3.yyyy, r0.yyyy

	mov r0.w,   ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1

	; w is kept in a temp on the way out, because it IS the fog distance and output registers
	; are write-only. Row 3 of both projections this game builds is (0, 0, -1, 0) — MEASURED,
	; arm-none-eabi-objdump on mtx_persptilt.o and mtx_perspstereotilt.o out of the shipped
	; libcitro3d.a, both storing the constant 0xbf800000 into r[3].z and leaving the rest of
	; the row at the memset zero — so this dot product is exactly -z_eye, i.e. the eye-space
	; depth in blocks, positive in front of the camera. One extra instruction over the
	; `dp4 outpos.w, ...` it replaces.
	dp4 r7.w, projection[3], r1
	mov outpos.w, r7.wwww

	; --- texture coordinates ---------------------------------------------
	; uvScale is a vec4, not a broadcast scalar: .x divides u (an atlas pixel column) by
	; the sheet WIDTH (16), .y multiplies v (a slot-edge index) by one slot's height in
	; texture space (16/1024). Same as world.v.pica.
	mul r2, uvScale, inpack
	mov outtc0, r2.xyxy

	; --- fog coordinate ----------------------------------------------------
	; u = depth * fogParams.x + fogParams.y, on the linear eye-space depth held in r7.w.
	; Deliberately NOT clamped here: gfx/fogtex.c sets GPU_CLAMP_TO_EDGE on the ramp, so the
	; sampler does it for free at every fragment, which is both cheaper and more correct than
	; clamping per vertex would be (a clamp before interpolation flattens the fade across a
	; quad that straddles either end of the ramp).
	;
	; Uniforms sit in the first source, same constraint as the light unpack below.
	;
	; Both components of outtc1 get the same value. All 8 rows of the ramp are identical, so v
	; is free; writing it from the same register costs one instruction instead of two.
	mul r7.x, fogParams.xxxx, r7.wwww
	add r7.x, fogParams.yyyy, r7.xxxx
	mov outtc1, r7.xxxx

	; --- v1.8.10 water shimmer coordinate ----------------------------------
	; uv = inpos.xz * waterShimmer.z + waterShimmer.xy, on r0 — which still holds the
	; CHUNK-LOCAL position (only .y was touched, by the water drop, and .y is not read here).
	; Chunk-local is correct and not a compromise: 16 blocks * 0.125 repeats per block is
	; exactly 2 whole repeats, so the sheet is continuous across every chunk boundary. See
	; WATER_SHIMMER_UV_PER_BLOCK in source/gfx/watershimmer.h for why that number and no other.
	;
	; r12 rather than one of the scratch registers above it: r0..r11 are all live somewhere in
	; this program and r12 is used by nothing, so this block cannot be broken by, and cannot
	; break, a later edit to the lighting.
	;
	; Uniforms sit in the first source, same constraint as the fog block above and the light
	; unpack below. Two instructions and a move, on every vertex in the world — the cost of the
	; option being compiled in rather than of it being switched on.
	mul r12, waterShimmer.zzzz, r0.xzxz
	add r12, waterShimmer.xyxy, r12
	mov outtc2, r12.xyxy

	; --- baked lighting ---------------------------------------------------
	; r3 was fetched at the top of main, exactly as in world.v.pica.

	; ao factor = aoFloor + aoRange * (ao / 3)
	; v1.8.8: r9.x, not inpack.wwww — the MASKED occlusion, with the tint index taken back out
	; of bits 2..4. See the split at the top of main.
	mul r4.x, aoScale, r9.xxxx
	mul r4.x, aoRange, r4.xxxx
	add r4.x, aoFloor, r4.xxxx

	; --- adaptive light ---------------------------------------------------
	; pad = sky*16 + block. Uniforms may only sit in source 1 on this assembler,
	; which fixes the operand order below.
	mul r5.x, inv16, inpos.wwww          ; sky raw 0..15
	flr r5.x, r5.xxxx
	mul r6.x, neg16, r5.xxxx             ; -16 * sky
	add r5.y, r6.xxxx, inpos.wwww        ; block raw 0..15
	mul r5.x, inv15, r5.xxxx             ; sky 0..1
	mul r5.y, inv15, r5.yyyy             ; block 0..1
	mul r5.z, dayLevel.xxxx, r5.xxxx     ; day-scaled sky

	; v1.8.10. The two light channels are CURVED SEPARATELY and then ADDED, replacing v1.8.9's
	; single curve over max(daySky, block). Vanilla's lightmap is
	;   table[sky] * sunBrightness  +  table[block] * (torchFlickerX * 0.1F + 1.5F)
	; then * 0.96F + 0.03F, clamped to 1. It is a SUM. The `max(sky, block)` line the wiki is
	; usually quoted for describes a different quantity — the "client light" the F3 readout and
	; the mob-spawning checks use — and taking it for the lightmap is the trap this shader was
	; in until now. See docs/research/light-and-torches.md.
	;
	; The difference only becomes visible with an emitter in the world, which is exactly what
	; v1.8.10 adds. Under max(), a torch could never make a spot brighter than open daylight
	; already was; standing in a lit doorway at noon, the torch contributed literally nothing.
	; Under a sum it adds on top and saturates, which is what a fire looks like.
	;
	; b = l / (4 - 3l) — see curveConsts above for the citation and the arithmetic that names
	; the uncurved version "3.2x too bright". r6.x/r6.y are scratch: r6.x's only earlier use
	; (the -16*sky above) was fully consumed before r5.y was written, and r6.y is not read by
	; anything until this block writes it. Both are rewritten between the two curves, so the
	; second curve cannot see the first one's leftovers.

	; sky term: curve(dayLevel * sky).
	; With no emitter anywhere in the world every vertex carries block = 0, the second term is
	; zero, and this reduces to EXACTLY the v1.8.9 expression. That is deliberate: 1.8.9's night
	; was measured and has not been playtested yet, and this release must not silently move it.
	mul r6.x, curveNegThree, r5.zzzz     ; -3 * skyLum
	add r6.x, curveFour, r6.xxxx         ; 4 - 3*skyLum
	rcp r6.y, r6.xxxx
	mul r5.z, r5.zzzz, r6.yyyy           ; curved sky

	; block term: curve(block) * 1.5.
	mul r6.x, curveNegThree, r5.yyyy     ; -3 * blockLum
	add r6.x, curveFour, r6.xxxx         ; 4 - 3*blockLum
	rcp r6.y, r6.xxxx
	mul r5.y, r5.yyyy, r6.yyyy           ; curved block
	mul r5.y, curveBlockMul, r5.yyyy     ; x 1.5, vanilla's torch multiplier at rest

	; the sum, and the clamp vanilla also applies. Without the clamp a torch at point-blank
	; range in daylight overdrives r5.w past 1 and the face washes to pure white, and worse,
	; the biome tint below is multiplied by it and stops being a tint.
	add r5.w, r5.zzzz, r5.yyyy           ; ADDITIVE — not max()
	min r5.w, ones, r5.wwww

	; colour = faceShade x aoCurve x lum x tint
	;
	; v1.8.8. The three lines above produce ONE brightness, and until this task all three
	; colour channels were written from it — `mov outclr.xyz, r6.zzz`, a grey. The tint is
	; therefore free at every stage after this one: it needs no extra varying (outclr was
	; already there and already interpolated), and no extra TexEnv stage (scene/chunk_render.c
	; stage 0 is already GPU_MODULATE of GPU_TEXTURE0 against GPU_PRIMARY_COLOR, so a coloured
	; vertex colour multiplies the texel that was always being multiplied by a grey one).
	; Two instructions here, and nothing anywhere else.
	mul r6.y, r3.xxxx, r4.xxxx
	mul r6.z, r6.yyyy, r5.wwww
	mul r11.xyz, r6.zzzz, r10
	mov outclr.xyz, r11.xyz

	; v1.8.2: the vertex alpha, straight out of the same table row. .w used to be written 1.0
	; and never read; scene/chunk_render.c now fills it with 0.70 for every row whose drop is
	; non-zero — which since WATER_SURFACE_DROP is water and nothing else — and 1.0 for the
	; rest. Zero extra instructions: r3 was fetched at the top of main. Must match
	; world.v.pica exactly; world/atlas_uv_shader_test.c and world/water_alpha_test.c both
	; parse this line out of BOTH files.
	mov outclr.w,   r3.wwww

	end
.end
