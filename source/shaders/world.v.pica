; Blocksmith — the world vertex shader.
;
; This is where the PICA200's missing fragment stage is paid for. There is no
; pixel shader on this GPU, so all lighting has to arrive as vertex data and be
; resolved here, then multiplied into the texture by a TEV combiner.
;
; Attributes (see MeshVertex in source/world/mesh_vertex.h — the format is locked):
;   v0 = position, 4x s8, in block units — only xyz is read, w is MeshVertex.pad
;        and exists only so that v1 starts on a 4-byte boundary. See the long note
;        in mesh_vertex.h: v0 being THREE components put v1 on offset 3 of an
;        8-byte vertex, and that unaligned attribute fetch is what froze the
;        console on the first world frame from v1.1.0 to v1.2.4.
;   v1 = (u, v, normal index, ao), 4x u8
;        u is an atlas pixel coordinate 0..255 (it exceeds 16 on a merged quad and
;        GPU_REPEAT wraps it), v is 0..240; both are scaled to 0..1 here
;        normal index 0..5 selects a baked face brightness
;        ao is 0..3, 3 meaning unoccluded

.fvec projection[4], modelView[4]

; Per-vertex face table, indexed by the WHOLE nrm byte. Two components are read:
;
;   .x  the face's baked brightness, exactly what this array has always held.
;   .y  a HEIGHT OFFSET added to the vertex's y, in world units. Zero for every row
;       whose index is a bare face id 0..5, which is every vertex the mesher emitted
;       before v1.8.0 task 22b.
;
; It is 64 rows and not 8 because nrm now packs a face index in bits 0..2 and a water
; height drop in bits 3..5 — see MESH_NRM_FACE_BITS in source/world/mesher.h for why the
; fraction could not live in the position bytes (they are whole block units and the GPU
; fetches them unscaled, so 7/8 of a block is not a number a vertex can hold). Row
; face + 8*d carries brightness(face) and -d/8, so a flowing water cell's lid and the tops
; of its four walls come down by d eighths and nothing else in the world moves at all.
;
; scene/chunk_render.c fills all 64. Still a power of two, which is what relative
; addressing wants.
.fvec faceShade[64]

; The atlas is a one-tile-wide strip (v1.6.0 task 11), so U and V no longer divide by the
; same number. x MUST be 1/ATLAS_W_PX. y is NOT 1/ATLAS_H_PX any more: since task 13b the
; vertex's v byte carries a SLOT-EDGE INDEX (tile, or tile+1), not an atlas pixel row, so
; y MUST be TILE_PX/ATLAS_H_PX — one slot's worth of texture space per unit of v. That is
; what lets a uint8_t address a 64-slot sheet: 64 fits in a byte, 1024 pixel rows do not.
; Both numbers come from source/world/atlas_uv.h. It was one scalar, consts.zzzz, while the
; sheet was square.
;
; A mismatch here renders no error at all, because a wrong scale still produces valid UVs
; and so still draws *a* texture. It has already happened once: step 9.3c shrank the sheet
; from 256x256 to 64x64 and left this at 1/256, which divided every tile's rect (atlas pixels
; 2..62 of 64) down into UV 0..0.2422 — all nine tiles collapsed into the same ~14x14px
; corner, the wood row. Measured on screen: every block drew with pale wood_top rings on top
; and wood_side bark grooves on the sides, so the whole world was one flat brown, with no
; grass green and no stone grey anywhere.
;
; This is one of four copies of the layout — here, source/shaders/world_dynamic.v.pica,
; source/world/atlas_uv.h and tools/make_atlas.py. source/world/atlas_uv_shader_test.c parses
; this line out of BOTH shaders and fails the host suite when either component disagrees with
; the header, which is the only reason the duplication is safe. Update all four together.
.constf uvScale(0.0625, 0.015625, 0.0, 0.0)       ; 1/ATLAS_W_PX = 1/16, TILE_PX/ATLAS_H_PX = 16/1024

; v1.8.8 biome tint. Eight RGB multipliers, indexed by bits 2..4 of the vertex's ao byte
; (MESH_TINT_BITS in source/world/mesher.h). Row 0 is (1,1,1) — the identity — and is what
; every untintable face and every vertex meshed without a biome source carries, so this
; multiply is exactly 1.0 for all of them and the frame is unchanged.
;
; EIGHT ROWS IS THE CAP, and it is this bank that sets it, not the vertex byte: the PICA200
; vertex stage has 96 float uniform registers in total and faceShade alone is 64 of them.
; Three bits is therefore what the mesher packs, and BIOME_COUNT (world/worldgen.h) is 6.
;
; Must match world_dynamic.v.pica exactly. That file is the one actually BOUND on both console
; models since the v1.8.0 shader split and this one is compiled and never bound, so an edit to
; only one of them is invisible either on the hardware or to the next person reading the file —
; the same drift world/atlas_uv_shader_test.c guards uvScale against.
; source/world/biome_tint_test.c parses the declaration and the decode instructions out of both.
.fvec tintPalette[8]

; v1.8.8. Splitting the ao byte: 1/4 shifts the tint index down out of bits 2..4, -4 undoes
; that shift inside the byte so what is left is the ambient occlusion 0..3.
.constf tintConsts(0.25, -4.0, 0.0, 0.0)
.alias  inv4 tintConsts.xxxx
.alias  neg4 tintConsts.yyyy

.constf consts(0.0, 1.0, 0.0, 0.33333333)         ; 0, 1, spare (was uvScale), 1/3
.alias  zeros consts.xxxx
.alias  ones  consts.yyyy
.alias  aoScale consts.wwww

; How much of the brightness AO is allowed to take away: a fully occluded corner
; keeps AO_FLOOR, an open one gets AO_FLOOR + AO_RANGE = 1.0.
.constf aoMix(0.45, 0.55, 0.0, 0.0)
.alias  aoFloor aoMix.xxxx
.alias  aoRange aoMix.yyyy

; v1.9.0 distance fog. .x is texcoord per block, .y is the coordinate at zero distance, so
; the fog coordinate is u = depth * .x + .y — an affine map of LINEAR eye-space depth onto
; the 128-texel ramp on texture unit 1. .z and .w are unused. Filled by
; scene/chunk_render.c's pipelineBind from fogShapeFor() (source/gfx/fogramp.c), which is
; also where the whole design and its measurement live.
;
; This replaced the PICA200's fixed-function fog unit, which is a 128-entry LUT indexed by
; 1/w: the knots bunch against the camera, the first one past the far plane sits at 20.6767
; blocks with the near plane at its cap, and everything beyond it is one straight line — so
; the fade could not be shaped past ~20.7 blocks at ANY render distance, and half_vis
; saturated at 14.34 / 14.37 / 14.41 blocks for radius 3 / 4 / 5. Eye-space depth has no
; knots in it.
;
; This file is COMPILED AND NEVER BOUND (see the note in scene/chunk_render.c), so nothing
; the fog does here reaches a screen. It is mirrored anyway for exactly the reason uvScale is:
; source/world/atlas_uv_shader_test.c parses the fog declarations and the fog instruction
; block out of BOTH files and fails if they drift, and that guard is only worth having while
; the two are actually kept identical.
.fvec fogParams[1]

.out outpos position
.out outtc0 texcoord0
.out outclr color

; v1.9.0. The fog coordinate, on its own varying.
;
; It could NOT ride on the spare lanes of outtc0. `mov outtc0, r2.xyxy` does write z and w,
; but texcoord0 is a TWO-component output semantic on this hardware — the assembler maps .x
; and .y and the rasterizer never sees the other two, so those lanes are discarded rather
; than spare. The only other route into texcoord0 is the separate `texcoord0w` semantic,
; which feeds texture unit 0's third coordinate and cannot be sampled by unit 1 at all.
; texcoord1 is unwritten everywhere else in the tree, so this costs nothing that was in use.
.out outtc1 texcoord1

.alias inpos v0
.alias inpack v1

.proc main
	; --- the vertex's face table row --------------------------------------
	; Fetched FIRST, because the position below needs its .y. Relative addressing, and the
	; only such construct in the project: `mova` loads the address register from the nrm
	; byte and faceShade[a0.x] then fetches a uniform at an offset the CPU never sees.
	;
	; v1.2.4 replaced these two lines with a constant index — `mov r3, faceShade[0]` — to
	; test them as the cause of the hardware freeze. That build still froze on the console,
	; so this is CLEARED by measurement, not by argument. The real cause was the unaligned
	; attribute fetch described in mesh_vertex.h; nothing was ever wrong with these two
	; instructions. Moving them above the position block changes nothing about them.
	mova a0.x, inpack.zzzz
	mov r3, faceShade[a0.x]

	; --- v1.8.8 biome tint: split the ao byte and fetch the palette row ----
	; inpack.w is ao | tint<<2 (world/mesher.h). The whole byte used to BE the occlusion and
	; the ao curve below multiplied it by 1/3 with no mask, so leaving the tint in it would
	; not be ignored — it would read as an occlusion of up to 31 and blow the face to white.
	; That is why this split is not optional and why it happens before anything reads .w.
	;
	; a0.x is re-loaded here rather than kept: r3 is already fetched above, so the faceShade
	; row this would clobber has been read and the register is free.
	mul r8.x, inv4, inpack.wwww          ; ao byte / 4
	flr r8.x, r8.xxxx                    ; tint index 0..7
	mul r9.x, neg4, r8.xxxx              ; -4 * tint
	add r9.x, r9.xxxx, inpack.wwww       ; ao 0..3, the value this shader always read
	mova a0.x, r8.xxxx
	mov r10, tintPalette[a0.x]

	; --- position ---------------------------------------------------------
	mov r0.xyz, inpos

	; v1.8.0 task 22b: the water height drop. r3.y is 0.0 for every face index 0..5, so
	; this is an exact no-op for every vertex that is not the top of a flowing water cell
	; — the pinned mesh hashes in source/world/world_test.c say the same thing on the CPU
	; side. One instruction, and it reuses a fetch the shader was already doing.
	add r0.y,   r3.yyyy, r0.yyyy

	mov r0.w,   ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1

	; w is kept in a temp on the way out, because it IS the fog distance and output registers
	; are write-only. Row 3 of both projections this game builds is (0, 0, -1, 0) — MEASURED,
	; arm-none-eabi-objdump on mtx_persptilt.o and mtx_perspstereotilt.o out of the shipped
	; libcitro3d.a, both storing the constant 0xbf800000 into r[3].z and leaving the rest of
	; the row at the memset zero — so this dot product is exactly -z_eye, i.e. the eye-space
	; depth in blocks, positive in front of the camera. One extra instruction over the
	; `dp4 outpos.w, ...` it replaces.
	dp4 r7.w, projection[3], r1
	mov outpos.w, r7.wwww

	; --- texture coordinates ---------------------------------------------
	; Atlas coords come in unnormalised because PICA byte attributes are not scaled.
	; uvScale is a vec4, not a broadcast scalar: .x divides u — still an atlas PIXEL
	; column — by the sheet WIDTH (16), while .y multiplies v — a SLOT-EDGE INDEX since
	; task 13b, 0..64 — by one slot's height in texture space (16/1024). .z/.w are zero
	; and multiply the normal index and ao into r2.zw, which the swizzle below throws away.
	mul r2, uvScale, inpack
	mov outtc0, r2.xyxy

	; --- fog coordinate ----------------------------------------------------
	; u = depth * fogParams.x + fogParams.y, on the linear eye-space depth held in r7.w.
	; Deliberately NOT clamped here: gfx/fogtex.c sets GPU_CLAMP_TO_EDGE on the ramp, so the
	; sampler does it for free at every fragment, which is both cheaper and more correct than
	; clamping per vertex would be (a clamp before interpolation flattens the fade across a
	; quad that straddles either end of the ramp).
	;
	; Uniforms sit in the first source, same constraint as world_dynamic.v.pica's light unpack.
	;
	; Both components of outtc1 get the same value. All 8 rows of the ramp are identical, so v
	; is free; writing it from the same register costs one instruction instead of two.
	mul r7.x, fogParams.xxxx, r7.wwww
	add r7.x, fogParams.yyyy, r7.xxxx
	mov outtc1, r7.xxxx

	; --- baked lighting ---------------------------------------------------
	; r3 was fetched at the top of main — see the note there for why, and for the v1.2.4
	; measurement that cleared the relative addressing itself of the hardware freeze.

	; ao factor = aoFloor + aoRange * (ao / 3)
	; v1.8.8: r9.x, not inpack.wwww — the MASKED occlusion, with the tint index taken back out
	; of bits 2..4. See the split at the top of main.
	mul r4.x, aoScale, r9.xxxx
	mul r4.x, aoRange, r4.xxxx
	add r4.x, aoFloor, r4.xxxx

	; colour = faceShade x aoCurve x tint
	;
	; v1.8.8. The line above produces ONE brightness and all three colour channels were written
	; from it — `mov outclr.xyz, r5.xxx`, a grey. The tint is therefore free at every stage
	; after this one: no extra varying (outclr was already there and already interpolated) and
	; no extra TexEnv stage (scene/chunk_render.c stage 0 is already GPU_MODULATE of
	; GPU_TEXTURE0 against GPU_PRIMARY_COLOR). One instruction here, and nothing anywhere else.
	mul r5, r3.xxxx, r4.xxxx
	mul r11.xyz, r5.xxxx, r10
	mov outclr.xyz, r11.xyz

	; v1.8.2: the vertex alpha, straight out of the same table row. .w used to be written 1.0
	; and never read; scene/chunk_render.c now fills it with 0.70 for every row whose drop is
	; non-zero — which since WATER_SURFACE_DROP is water and nothing else — and 1.0 for the
	; rest. Zero extra instructions: r3 was fetched at the top of main. Must match
	; world_dynamic.v.pica exactly; world/atlas_uv_shader_test.c and world/water_alpha_test.c
	; both parse this line out of BOTH files.
	mov outclr.w,   r3.wwww

	end
.end
