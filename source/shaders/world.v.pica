; Blocksmith — the world vertex shader.
;
; This is where the PICA200's missing fragment stage is paid for. There is no
; pixel shader on this GPU, so all lighting has to arrive as vertex data and be
; resolved here, then multiplied into the texture by a TEV combiner.
;
; Attributes (see MeshVertex in source/world/mesh_vertex.h — the format is locked):
;   v0 = position, 4x s8, in block units — only xyz is read, w is MeshVertex.pad
;        and exists only so that v1 starts on a 4-byte boundary. See the long note
;        in mesh_vertex.h: v0 being THREE components put v1 on offset 3 of an
;        8-byte vertex, and that unaligned attribute fetch is what froze the
;        console on the first world frame from v1.1.0 to v1.2.4.
;   v1 = (u, v, normal index, ao), 4x u8
;        u is an atlas pixel coordinate 0..255 (it exceeds 16 on a merged quad and
;        GPU_REPEAT wraps it), v is 0..240; both are scaled to 0..1 here
;        normal index 0..5 selects a baked face brightness
;        ao is 0..3, 3 meaning unoccluded

.fvec projection[4], modelView[4]

; Per-face brightness, indexed by the vertex's normal index. Six are used; the
; array is 8 long because relative addressing wants a power of two to be safe.
.fvec faceShade[8]

; The atlas is a one-tile-wide strip (v1.6.0 task 11), so U and V no longer divide by the
; same number: x MUST be 1/ATLAS_W_PX and y MUST be 1/ATLAS_H_PX, both from
; source/world/atlas_uv.h. It was one scalar, consts.zzzz, while the sheet was square.
;
; A mismatch here renders no error at all, because a wrong scale still produces valid UVs
; and so still draws *a* texture. It has already happened once: step 9.3c shrank the sheet
; from 256x256 to 64x64 and left this at 1/256, which divided every tile's rect (atlas pixels
; 2..62 of 64) down into UV 0..0.2422 — all nine tiles collapsed into the same ~14x14px
; corner, the wood row. Measured on screen: every block drew with pale wood_top rings on top
; and wood_side bark grooves on the sides, so the whole world was one flat brown, with no
; grass green and no stone grey anywhere.
;
; This is one of four copies of the layout — here, source/shaders/world_dynamic.v.pica,
; source/world/atlas_uv.h and tools/make_atlas.py. source/world/atlas_uv_shader_test.c parses
; this line out of BOTH shaders and fails the host suite when either component disagrees with
; the header, which is the only reason the duplication is safe. Update all four together.
.constf uvScale(0.0625, 0.00390625, 0.0, 0.0)     ; 1/ATLAS_W_PX = 1/16, 1/ATLAS_H_PX = 1/256

.constf consts(0.0, 1.0, 0.0, 0.33333333)         ; 0, 1, spare (was uvScale), 1/3
.alias  zeros consts.xxxx
.alias  ones  consts.yyyy
.alias  aoScale consts.wwww

; How much of the brightness AO is allowed to take away: a fully occluded corner
; keeps AO_FLOOR, an open one gets AO_FLOOR + AO_RANGE = 1.0.
.constf aoMix(0.45, 0.55, 0.0, 0.0)
.alias  aoFloor aoMix.xxxx
.alias  aoRange aoMix.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias inpack v1

.proc main
	; --- position ---------------------------------------------------------
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; --- texture coordinates ---------------------------------------------
	; Atlas pixel coords come in unnormalised because PICA byte attributes are not
	; scaled. uvScale is a vec4 now, not a broadcast scalar: .x divides u by the sheet
	; WIDTH (16) and .y divides v by its HEIGHT (256). .z/.w are zero and multiply the
	; normal index and ao into r2.zw, which the swizzle below throws away.
	mul r2, uvScale, inpack
	mov outtc0, r2.xyxy

	; --- baked lighting ---------------------------------------------------
	; Relative addressing, and the only such construct in the project: `mova` loads the address
	; register from the normal index carried on the vertex, and faceShade[a0.x] then fetches a
	; uniform at an offset the CPU never sees.
	;
	; v1.2.4 replaced these two lines with a constant index — `mov r3, faceShade[0]` — to test
	; them as the cause of the hardware freeze. That build still froze on the console, so this
	; is CLEARED by measurement, not by argument, and is restored here unchanged. The real
	; cause was the unaligned attribute fetch described in mesh_vertex.h; nothing was ever
	; wrong with these two instructions.
	mova a0.x, inpack.zzzz
	mov r3, faceShade[a0.x]

	; ao factor = aoFloor + aoRange * (ao / 3)
	mul r4.x, aoScale, inpack.wwww
	mul r4.x, aoRange, r4.xxxx
	add r4.x, aoFloor, r4.xxxx

	mul r5, r3.xxxx, r4.xxxx
	mov outclr.xyz, r5.xxx
	mov outclr.w,   ones

	end
.end
