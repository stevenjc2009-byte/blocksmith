; Blocksmith — the world vertex shader.
;
; This is where the PICA200's missing fragment stage is paid for. There is no
; pixel shader on this GPU, so all lighting has to arrive as vertex data and be
; resolved here, then multiplied into the texture by a TEV combiner.
;
; Attributes (see MeshVertex in source/world/mesh_vertex.h — the format is locked):
;   v0 = position, 3x s8, in block units
;   v1 = (u, v, normal index, ao), 4x u8
;        u/v are atlas pixel coordinates 0..255, scaled to 0..1 here
;        normal index 0..5 selects a baked face brightness
;        ao is 0..3, 3 meaning unoccluded

.fvec projection[4], modelView[4]

; Per-face brightness, indexed by the vertex's normal index. Six are used; the
; array is 8 long because relative addressing wants a power of two to be safe.
.fvec faceShade[8]

.constf consts(0.0, 1.0, 0.00390625, 0.33333333)   ; 0, 1, 1/256, 1/3
.alias  zeros consts.xxxx
.alias  ones  consts.yyyy
.alias  uvScale consts.zzzz
.alias  aoScale consts.wwww

; How much of the brightness AO is allowed to take away: a fully occluded corner
; keeps AO_FLOOR, an open one gets AO_FLOOR + AO_RANGE = 1.0.
.constf aoMix(0.45, 0.55, 0.0, 0.0)
.alias  aoFloor aoMix.xxxx
.alias  aoRange aoMix.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias inpack v1

.proc main
	; --- position ---------------------------------------------------------
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; --- texture coordinates ---------------------------------------------
	; Atlas pixel coords come in unnormalised (0..255) because PICA byte
	; attributes are not scaled, so 1/256 converts them.
	mul r2, uvScale, inpack
	mov outtc0, r2.xyxy

	; --- baked lighting ---------------------------------------------------
	; faceShade[normal index]
	mova a0.x, inpack.zzzz
	mov r3, faceShade[a0.x]

	; ao factor = aoFloor + aoRange * (ao / 3)
	mul r4.x, aoScale, inpack.wwww
	mul r4.x, aoRange, r4.xxxx
	add r4.x, aoFloor, r4.xxxx

	mul r5, r3.xxxx, r4.xxxx
	mov outclr.xyz, r5.xxx
	mov outclr.w,   ones

	end
.end
