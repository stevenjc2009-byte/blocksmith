; Blocksmith — the world vertex shader.
;
; This is where the PICA200's missing fragment stage is paid for. There is no
; pixel shader on this GPU, so all lighting has to arrive as vertex data and be
; resolved here, then multiplied into the texture by a TEV combiner.
;
; Attributes (see MeshVertex in source/world/mesh_vertex.h — the format is locked):
;   v0 = position, 3x s8, in block units
;   v1 = (u, v, normal index, ao), 4x u8
;        u/v are atlas pixel coordinates 0..63, scaled to 0..1 here
;        normal index 0..5 selects a baked face brightness
;        ao is 0..3, 3 meaning unoccluded

.fvec projection[4], modelView[4]

; Per-face brightness, indexed by the vertex's normal index. Six are used; the
; array is 8 long because relative addressing wants a power of two to be safe.
.fvec faceShade[8]

; uvScale MUST be 1/ATLAS_PX, with ATLAS_PX from source/world/atlas_uv.h. It was 1/256 —
; left behind when step 9.3c shrank the sheet from 256x256 to 64x64 — and nothing catches a
; mismatch, because a wrong scale still produces valid UVs and so still renders *a* texture.
; At 1/256 every tile's rect (spanning atlas pixels 2..62 of 64) divided by 256 landed inside
; UV 0..0.2422, i.e. all nine tiles collapsed into the same ~14x14 px corner of the sheet —
; the wood row. Measured on screen: every block in the world drew with pale wood_top rings on
; top and wood_side bark grooves on the sides, so the whole world was one flat brown, with no
; grass green and no stone grey anywhere. With 1/64 the tiles reach UV 0.9688 and separate.
.constf consts(0.0, 1.0, 0.015625, 0.33333333)   ; 0, 1, 1/64, 1/3
.alias  zeros consts.xxxx
.alias  ones  consts.yyyy
.alias  uvScale consts.zzzz
.alias  aoScale consts.wwww

; How much of the brightness AO is allowed to take away: a fully occluded corner
; keeps AO_FLOOR, an open one gets AO_FLOOR + AO_RANGE = 1.0.
.constf aoMix(0.45, 0.55, 0.0, 0.0)
.alias  aoFloor aoMix.xxxx
.alias  aoRange aoMix.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias inpack v1

.proc main
	; --- position ---------------------------------------------------------
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; --- texture coordinates ---------------------------------------------
	; Atlas pixel coords come in unnormalised (0..63) because PICA byte
	; attributes are not scaled, so 1/64 converts them.
	mul r2, uvScale, inpack
	mov outtc0, r2.xyxy

	; --- baked lighting ---------------------------------------------------
	; v1.2.4 EXPERIMENT, and the only change in this build. Restore the two commented
	; lines to undo it.
	;
	; The round-2 draw bisect (v1.2.3, run on hardware) came back: arm 2 "cull only, no GPU
	; command" SURVIVED, so the freeze is not a CPU loop. Arm 5 "GPU state set up, no draw
	; calls" SURVIVED, so it is not the program bind, the attribute config, the texture bind,
	; the depth/blend/fog state or the uniform uploads. Arms 3 (opaque only) and 4 (transparent
	; only) BOTH hung, so it is not anything unique to either pass. What is left is what only
	; happens once a chunk draw is actually issued - and the biggest thing in that set is this
	; shader running per vertex.
	;
	; These two lines are the only relative addressing anywhere in the project. `mova` loads
	; the address register from a value read off the vertex, and `faceShade[a0.x]` then fetches
	; a uniform at an offset the CPU never sees. That is precisely the kind of construct an
	; emulator implements as a bounds-safe array lookup while the silicon does a raw fetch out
	; of the constant bank, which fits "hardware only, never in Azahar".
	;
	; The replacement keeps the faceShade array declared AND read, so picasso still emits it
	; into the uniform table and shaderInstanceGetUniformLocation still resolves it - if the
	; array became unused, that lookup could return -1 and chunk_render.c's upload loop would
	; write to whatever sits below the array. Only the INDEXING changes. One variable.
	;
	; Expected on screen if this was the cause: the world draws, textures are correct, but
	; every face is lit identically at faceShade[0] = 0.78 (FACE_EAST). No bright tops, no
	; dark undersides. That flatness is also the proof the new shader is the one running - if
	; the lighting still varies by face, this build did not take effect and any conclusion
	; from it is void.
	;
	;	mova a0.x, inpack.zzzz
	;	mov r3, faceShade[a0.x]
	mov r3, faceShade[0]

	; ao factor = aoFloor + aoRange * (ao / 3)
	mul r4.x, aoScale, inpack.wwww
	mul r4.x, aoRange, r4.xxxx
	add r4.x, aoFloor, r4.xxxx

	mul r5, r3.xxxx, r4.xxxx
	mov outclr.xyz, r5.xxx
	mov outclr.w,   ones

	end
.end
