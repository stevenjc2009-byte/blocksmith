# makerom spec for the Blocksmith CIA.
#
# Adapted from the working sibling project's spec,
# 3ds-project-folder/model-making/modelkit.rsf, which is itself adapted from
# Universal-Team/Universal-Updater's app/build-cia.rsf — a known-good shipping
# homebrew spec. The permission, syscall and service lists below are left
# EXACTLY as that proven-working template had them, on the same reasoning the
# sibling file states: they are wider than this game needs, but trimming them
# is how you build a title that installs and then crashes instead of one that
# just runs. Everything changed from the sibling is called out at the point of
# the change, below.
#
# Changed from the sibling (modelkit.rsf):
#   * Title / ProductCode / UniqueId - this game, not that one. See the
#     "Title ID" note above TitleInfo for why 0xB10CC is safe to use.
#   * RomFs section - RESTORED (2026-08-19, source/app/updater.c step). The
#     header note directly above used to say this was removed because
#     Blocksmith had no ROMFS variable and no romfs/ directory. That is no
#     longer true: the Makefile now sets ROMFS := romfs and romfs/cacert.pem
#     (copied verbatim from the sibling's own romfs/cacert.pem) is the CA
#     bundle the in-app updater hands to libcurl so it can trust github.com.
#     Without this section makerom has nothing to embed the file with and the
#     CIA build's updater would have no certificate to check against, even
#     though the .3dsx build (which reads ROMFS straight off the Makefile)
#     would work fine - the two builds would silently disagree. See the
#     RomFs block itself, below, for the same comment the sibling's carries.
#   * SaveDataSize - unchanged at 0KB, same reasoning as the sibling: the
#     game does not write a save file yet. Revisit when persistence lands.
#   * SystemMode - unchanged at 64MB, the retail Old 3DS budget this project
#     has been built and measured against from the start (see the Makefile's
#     -O3 comment for the same "measured, not assumed" standard applied to
#     the C build).
#   * DirectSdmcWrite is already in the sibling's FileSystemAccess list and is
#     kept here unchanged - Blocksmith is a voxel game that will need to
#     write world saves to the SD card, same as the sibling's updater needs
#     SD write access for its own reasons. No entries were added or removed
#     from either the FileSystemAccess or ServiceAccessControl lists.

BasicInfo:
  Title                   : "Blocksmith"
  ProductCode             : "CTR-P-BLKS" # FreeProductCode below removes the format
                                          # restriction Nintendo's real codes follow -
                                          # this one is just readable as this game's name.
  Logo                    : Homebrew # Nintendo / Licensed / Distributed / iQue / iQueForSystem

TitleInfo:
  Category                : Application
  # Title ID: safety reasoning.
  #
  # A 3DS Title ID is 0004000 0<UniqueId><variation>, so the only thing
  # actually being chosen here is UniqueId - a 20-bit field. This value,
  # 0xB10CC, is:
  #   - Different from the sibling project's 0xF3DBA (no collision with
  #     model-making's installed CIA on the same SD card).
  #   - Outside the low system-reserved block (3dbrew documents Nintendo's
  #     own applications, applets and services occupying the low
  #     0x00000-0x00FFF range of this field) so it cannot alias a system
  #     title.
  #   - Not a value drawn from any published Nintendo eShop/retail title-ID
  #     list - those are specific assigned numbers, not this arbitrary one -
  #     so collision with a real game is not expected.
  # The only real-world risk left is colliding with some OTHER homebrew CIA
  # already sitting on steve's specific SD card, since homebrew IDs are
  # picked by hand like this one rather than centrally assigned. That is a
  # local, checkable condition (FBI lists installed titles by ID before
  # install), not something this file can rule out by itself - flagging it
  # rather than claiming it is impossible.
  UniqueId                : 0xB10CC

Option:
  UseOnSD                 : true # true if App is to be installed to SD
  FreeProductCode         : true # Removes limitations on ProductCode
  MediaFootPadding        : false # If true CCI files are created with padding
  EnableCrypt             : false # Enables encryption for NCCH and CIA
  EnableCompress          : true # Compresses where applicable (currently only exefs:/.code)

AccessControlInfo:
  CoreVersion                   : 2

  # Exheader Format Version
  DescVersion                   : 2

  # Minimum Required Kernel Version (below is for 4.5.0)
  ReleaseKernelMajor            : "02"
  ReleaseKernelMinor            : "33"

  # ExtData
  UseExtSaveData                : false # enables ExtData

  # FS:USER Archive Access Permissions
  FileSystemAccess:
   - CategorySystemApplication
   - CategoryHardwareCheck
   - CategoryFileSystemTool
   - Debug
   - TwlCardBackup
   - TwlNandData
   - DirectSdmc
   - Core
   - CategorySystemSettings
   - DirectSdmcWrite
  IoAccessControl:
   - FsMountTwln
   - FsMountCardSpi
   - UseSdif3
   - UseCardSpi

  # Process Settings
  MemoryType                    : Application # Application/System/Base
  SystemMode                    : 64MB # 64MB(Default)/96MB/80MB/72MB/32MB
  IdealProcessor                : 0
  # AffinityMask is DELIBERATELY 1, and 1 is not a limitation to be fixed. Read this before
  # "correcting" it to 3 -- v1.8.17 (N3D-CORE) spent a lane establishing the following.
  #
  # What it is: libctru's include/3ds/exheader.h declares it `u8 affinity_mask : 2`, packed
  # with `ideal_processor : 2` and `o3ds_system_mode : 4` into the one byte at exheader
  # AccessControlInfo + 0x0E. Measured, not assumed: building this RSF with 1 and with 3 and
  # diffing the two .cia files changes exactly ONE byte, ACI+0x0E, 0x04 -> 0x0C. So the field
  # is real and it does map where the header says it does.
  #
  # What it does NOT do: gate svcCreateThread. 3dbrew's Multi-threading page lists the
  # kernel's processor-id checks -- kernel-flags 0x2000 for core 2, outright refusal of core
  # 3 -- and then states "These are the only restriction checks done by the kernel for
  # processorid." Core 1 is gated by APT_SetAppCpuTimeLimit instead, exactly as libctru's
  # svc.h says. Public homebrew RSFs ship AffinityMask : 1 essentially universally while
  # using the APT_SetAppCpuTimeLimit + core-1 recipe successfully, which could not happen if
  # this field blocked core 1.
  #
  # Why it stays 1: changing it buys no capability, forces a reinstall, and deviates from
  # what every shipping homebrew title does. 3dbrew also documents an AccessDesc cross-check
  # for the neighbouring fields in this byte ("the AccessDesc must have the corresponding bit
  # set, otherwise the invalid-exheader error is returned"), and a title that fails that
  # check does not launch at all. That is a real launch risk taken for nothing.
  #
  # See the long note in source/app/worker.h, which used to claim the opposite and now
  # carries the correction and its sources.
  AffinityMask                  : 1
  Priority                      : 16
  MaxCpu                        : 0x9E # Default
  HandleTableSize               : 0x200
  DisableDebug                  : false
  EnableForceDebug              : false
  CanWriteSharedPage            : true
  CanUsePrivilegedPriority      : false
  CanUseNonAlphabetAndNumber    : true
  PermitMainFunctionArgument    : true
  CanShareDeviceMemory          : true
  RunnableOnSleep               : false
  SpecialMemoryArrange          : true

  # New3DS Exclusive Process Settings
  SystemModeExt                 : 124MB # Legacy(Default)/124MB/178MB  Legacy:Use Old3DS SystemMode
  CpuSpeed                      : 804MHz # 268MHz(Default)/804MHz
  EnableL2Cache                 : true # false(default)/true
  CanAccessCore2                : true

  # Virtual Address Mappings
  IORegisterMapping:
   - 1ff00000-1ff7ffff   # DSP memory
  MemoryMapping:
   - 1f000000-1f5fffff:r # VRAM

  # Accessible SVCs, <Name>:<ID>
  SystemCallAccess:
    ControlMemory: 1
    QueryMemory: 2
    ExitProcess: 3
    GetProcessAffinityMask: 4
    SetProcessAffinityMask: 5
    GetProcessIdealProcessor: 6
    SetProcessIdealProcessor: 7
    CreateThread: 8
    ExitThread: 9
    SleepThread: 10
    GetThreadPriority: 11
    SetThreadPriority: 12
    GetThreadAffinityMask: 13
    SetThreadAffinityMask: 14
    GetThreadIdealProcessor: 15
    SetThreadIdealProcessor: 16
    GetCurrentProcessorNumber: 17
    Run: 18
    CreateMutex: 19
    ReleaseMutex: 20
    CreateSemaphore: 21
    ReleaseSemaphore: 22
    CreateEvent: 23
    SignalEvent: 24
    ClearEvent: 25
    CreateTimer: 26
    SetTimer: 27
    CancelTimer: 28
    ClearTimer: 29
    CreateMemoryBlock: 30
    MapMemoryBlock: 31
    UnmapMemoryBlock: 32
    CreateAddressArbiter: 33
    ArbitrateAddress: 34
    CloseHandle: 35
    WaitSynchronization1: 36
    WaitSynchronizationN: 37
    SignalAndWait: 38
    DuplicateHandle: 39
    GetSystemTick: 40
    GetHandleInfo: 41
    GetSystemInfo: 42
    GetProcessInfo: 43
    GetThreadInfo: 44
    ConnectToPort: 45
    SendSyncRequest1: 46
    SendSyncRequest2: 47
    SendSyncRequest3: 48
    SendSyncRequest4: 49
    SendSyncRequest: 50
    OpenProcess: 51
    OpenThread: 52
    GetProcessId: 53
    GetProcessIdOfThread: 54
    GetThreadId: 55
    GetResourceLimit: 56
    GetResourceLimitLimitValues: 57
    GetResourceLimitCurrentValues: 58
    GetThreadContext: 59
    Break: 60
    OutputDebugString: 61
    ControlPerformanceCounter: 62
    CreatePort: 71
    CreateSessionToPort: 72
    CreateSession: 73
    AcceptSession: 74
    ReplyAndReceive1: 75
    ReplyAndReceive2: 76
    ReplyAndReceive3: 77
    ReplyAndReceive4: 78
    ReplyAndReceive: 79
    BindInterrupt: 80
    UnbindInterrupt: 81
    InvalidateProcessDataCache: 82
    StoreProcessDataCache: 83
    FlushProcessDataCache: 84
    StartInterProcessDma: 85
    StopDma: 86
    GetDmaState: 87
    RestartDma: 88
    DebugActiveProcess: 96
    BreakDebugProcess: 97
    TerminateDebugProcess: 98
    GetProcessDebugEvent: 99
    ContinueDebugEvent: 100
    GetProcessList: 101
    GetThreadList: 102
    GetDebugThreadContext: 103
    SetDebugThreadContext: 104
    QueryDebugProcessMemory: 105
    ReadProcessMemory: 106
    WriteProcessMemory: 107
    SetHardwareBreakPoint: 108
    GetDebugThreadParam: 109
    ControlProcessMemory: 112
    MapProcessMemory: 113
    UnmapProcessMemory: 114
    CreateCodeSet: 115
    CreateProcess: 117
    TerminateProcess: 118
    SetProcessResourceLimits: 119
    CreateResourceLimit: 120
    SetResourceLimitValues: 121
    AddCodeSegment: 122
    Backdoor: 123
    KernelSetState: 124
    QueryProcessMemory: 125

  # Service List
  # Maximum 34 services (32 if firmware is prior to 9.6.0)
  ServiceAccessControl:
   - APT:U
   - ac:u
   - am:net
   - cfg:u
   - dsp::DSP
   - fs:USER
   - gsp::Gpu
   - gsp::Lcd
   - hid:USER
   - http:C
   - nwm::EXT
   - nwm::UDS
   - ptm:sysm
   - ptm:u
   - pxi:dev
   - soc:U
   - ssl:C

# The read-only filesystem baked into the title. One file lives here:
# cacert.pem, the Mozilla CA bundle, which libcurl is pointed at so the
# updater's check can verify github.com. The .3dsx build gets the same
# directory through the Makefile's --romfs flag (ROMFS := romfs), so both
# builds read the identical path, romfs:/cacert.pem. Copied verbatim from the
# sibling project's own RomFs block (3ds-project-folder/model-making/modelkit.rsf).
RomFs:
  RootPath: romfs

SystemControlInfo:
  SaveDataSize: 0KB # Change if the app uses savedata
  RemasterVersion: 0
  StackSize: 0x40000

  # Modules that run services listed above should be included below
  # Maximum 48 dependencies
  # <module name>:<module titleid>
  Dependency:
    ac: 0x0004013000002402
    am: 0x0004013000001502
    boss: 0x0004013000003402
    camera: 0x0004013000001602
    cecd: 0x0004013000002602
    cfg: 0x0004013000001702
    codec: 0x0004013000001802
    csnd: 0x0004013000002702
    dlp: 0x0004013000002802
    dsp: 0x0004013000001a02
    friends: 0x0004013000003202
    gpio: 0x0004013000001b02
    gsp: 0x0004013000001c02
    hid: 0x0004013000001d02
    http: 0x0004013000002902
    i2c: 0x0004013000001e02
    ir: 0x0004013000003302
    mcu: 0x0004013000001f02
    mic: 0x0004013000002002
    ndm: 0x0004013000002b02
    news: 0x0004013000003502
    nim: 0x0004013000002c02
    nwm: 0x0004013000002d02
    pdn: 0x0004013000002102
    ps: 0x0004013000003102
    ptm: 0x0004013000002202
    ro: 0x0004013000003702
    socket: 0x0004013000002e02
    spi: 0x0004013000002302
    ssl: 0x0004013000002f02
